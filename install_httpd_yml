---
- name: Configure Apache and PHP on Rocky Linux
  hosts: all
  become: true

  tasks:
    - name: Install httpd and PHP
      ansible.builtin.dnf:
        name:
          - httpd
          - php
        state: present
        update_cache: true
      when: ansible_facts["distribution"] == "Rocky"

    - name: Start and enable httpd
      ansible.builtin.service:
        name: httpd
        state: started
        enabled: true
      when: ansible_facts["distribution"] == "Rocky"
