---
- hosts: all
  become: true

  tasks:
    - name: Update repository index
      dnf:
        update_cache: true 
      when:  ansible_facts["distribution"] == "Rocky"

    - name: Install httpd package
      dnf:
        name: httpd
        state: present 
      when:  ansible_facts["distribution"] == "Rocky" 

    - name: Install PHP support
      dnf:
        name: php
        state: present 
      when:  ansible_facts["distribution"] == "Rocky"
